{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "patient:run",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/service/patient"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "medilabo"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "gateway:run",
      "type": "shell",
      "command": "mvn spring-boot:run",
      "options": {
        "cwd": "${workspaceFolder}/service/gateway"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "medilabo"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "frontend:dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "medilabo"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "mysql:setup",
      "type": "shell",
      "command": "./scripts/setup-mysql.ps1 -RootPassword \"${input:mysqlRootPassword}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "mysqlRootPassword",
      "type": "promptString",
      "description": "MySQL root password",
      "password": true
    }
  ]
}
