{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "Patient",
      "request": "launch",
      "mainClass": "com.medilabo.patient.PatientApplication",
      "projectName": "patient",
      "cwd": "${workspaceFolder}/service/patient"
    },
    {
      "type": "java",
      "name": "Notes",
      "request": "launch",
      "mainClass": "com.medilabo.notes.NotesApplication",
      "projectName": "notes",
      "cwd": "${workspaceFolder}/service/notes"
    },
    {
      "type": "java",
      "name": "Gateway",
      "request": "launch",
      "mainClass": "com.medilabo.gateway.GatewayApplication",
      "projectName": "gateway",
      "cwd": "${workspaceFolder}/service/gateway"
    },
    {
      "type": "node",
      "name": "Frontend",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal"
    },
    {
      "type": "java",
      "name": "Patient — restart",
      "request": "launch",
      "mainClass": "com.medilabo.patient.PatientApplication",
      "projectName": "patient",
      "cwd": "${workspaceFolder}/service/patient",
      "preLaunchTask": "kill-port:8081"
    },
    {
      "type": "java",
      "name": "Notes — restart",
      "request": "launch",
      "mainClass": "com.medilabo.notes.NotesApplication",
      "projectName": "notes",
      "cwd": "${workspaceFolder}/service/notes",
      "preLaunchTask": "kill-port:8082"
    },
    {
      "type": "java",
      "name": "Gateway — restart",
      "request": "launch",
      "mainClass": "com.medilabo.gateway.GatewayApplication",
      "projectName": "gateway",
      "cwd": "${workspaceFolder}/service/gateway",
      "preLaunchTask": "kill-port:8080"
    },
    {
      "type": "node",
      "name": "Frontend — restart",
      "request": "launch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "${workspaceFolder}/frontend",
      "console": "integratedTerminal",
      "preLaunchTask": "kill-port:3000"
    },
    {
      "type": "node",
      "name": "Patient — tests",
      "request": "launch",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["test"],
      "windows": {
        "runtimeExecutable": "mvn.cmd"
      },
      "cwd": "${workspaceFolder}/service/patient",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "name": "Gateway — tests",
      "request": "launch",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["test"],
      "windows": {
        "runtimeExecutable": "mvn.cmd"
      },
      "cwd": "${workspaceFolder}/service/gateway",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    },
    {
      "type": "node",
      "name": "Medilabo — all tests",
      "request": "launch",
      "runtimeExecutable": "mvn",
      "runtimeArgs": ["test"],
      "windows": {
        "runtimeExecutable": "mvn.cmd"
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ],
  "compounds": [
    {
      "name": "Medilabo Full Backend Restart",
      "configurations": ["Patient — restart", "Notes — restart", "Gateway — restart"],
      "preLaunchTask": "kill-ports:backend",
      "stopAll": true
    }
  ]
}
